{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionFacets",
  "description": "Per-session semantic facets extracted by LLM analysis. Cached at facets-cache/{session_id}.json",
  "type": "object",
  "required": ["sessionId", "extractedAt", "modelUsed", "facets"],
  "properties": {
    "sessionId": { "type": "string" },
    "extractedAt": { "type": "string", "format": "date-time" },
    "modelUsed": { "type": "string", "description": "e.g. gpt-4o, claude-3.5-sonnet" },
    "transcriptHash": { "type": "string", "description": "MD5 hash of source transcript for cache invalidation" },
    "facets": {
      "type": "object",
      "required": ["briefSummary", "goalCategories", "outcome"],
      "properties": {
        "briefSummary": { "type": "string", "maxLength": 200 },
        "underlyingGoal": { "type": "string", "maxLength": 300 },
        "goalCategories": {
          "type": "object",
          "description": "Goal category → occurrence count. Higher count = more dominant goal. Keys from: feature_work, bug_fix, refactoring, testing, documentation, devops_infra, code_review, learning_exploration, data_analysis, design_architecture, migration_upgrade, performance_optimization, security",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "outcome": {
          "enum": ["fully_achieved", "mostly_achieved", "partially_achieved", "barely_started", "abandoned"]
        },
        "sessionType": {
          "enum": ["focused_coding", "exploration", "debugging", "planning", "review", "mixed"]
        },
        "userSatisfaction": {
          "type": "object",
          "properties": {
            "counts": {
              "type": "object",
              "properties": {
                "highly_satisfied": { "type": "integer" },
                "satisfied": { "type": "integer" },
                "neutral": { "type": "integer" },
                "slightly_frustrated": { "type": "integer" },
                "frustrated": { "type": "integer" },
                "very_frustrated": { "type": "integer" },
                "confused": { "type": "integer" },
                "impressed": { "type": "integer" }
              }
            },
            "overall": {
              "enum": ["highly_satisfied", "satisfied", "neutral", "slightly_frustrated", "frustrated", "very_frustrated"]
            }
          }
        },
        "claudeHelpfulness": {
          "enum": ["extremely_helpful", "very_helpful", "moderately_helpful", "slightly_helpful", "not_helpful"]
        },
        "frictionCounts": {
          "type": "object",
          "properties": {
            "wrong_approach": { "type": "integer" },
            "hallucination": { "type": "integer" },
            "ignored_instruction": { "type": "integer" },
            "repetitive_error": { "type": "integer" },
            "context_lost": { "type": "integer" },
            "slow_response": { "type": "integer" },
            "tool_failure": { "type": "integer" },
            "incomplete_solution": { "type": "integer" },
            "wrong_file_edit": { "type": "integer" },
            "unnecessary_changes": { "type": "integer" },
            "poor_code_quality": { "type": "integer" },
            "misunderstood_request": { "type": "integer" }
          }
        },
        "frictionDetail": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief narrative of friction points encountered"
        },
        "primarySuccess": {
          "type": "string",
          "maxLength": 300,
          "description": "What went well in this session"
        },
        "userInstructionsToClaude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit preferences or rules the user stated during the session"
        },
        "userInterruptions": {
          "type": "integer",
          "description": "Count of times user interrupted/cancelled the assistant mid-response"
        },
        "firstPrompt": {
          "type": "string",
          "maxLength": 500,
          "description": "The first user message in the session, for quick categorization"
        },
        "correctionEvents": {
          "type": "object",
          "properties": {
            "business_misunderstanding": { "type": "integer", "description": "Agent misunderstood domain/business requirements" },
            "test_quality_complaint": { "type": "integer", "description": "User complained about test quality/coverage" },
            "execution_deviation": { "type": "integer", "description": "Agent deviated from user's explicit instructions" },
            "overengineering": { "type": "integer", "description": "Agent over-complicated the solution" }
          },
          "description": "Counts of user correction/push-back events by category"
        },
        "emotionEscalation": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "description": "Direct user quotes showing significant frustration or emotion (verbatim, up to 5 quotes)"
        },
        "frictionDensity": {
          "type": "number",
          "description": "Total friction events divided by session message count — higher = more friction-dense"
        },
        "turnAnalysis": {
          "type": "object",
          "description": "Turn-level analysis of the conversation",
          "properties": {
            "turnCount": { "type": "integer", "description": "Total number of conversation turns" },
            "avgTurnDurationSec": { "type": "number", "description": "Average turn duration in seconds" },
            "longestTurn": {
              "type": "object",
              "properties": {
                "turnId": { "type": "string" },
                "durSec": { "type": "number" },
                "reason": { "type": "string" }
              }
            },
            "turnEfficiency": { "type": "string", "enum": ["high", "medium", "low"], "description": "Overall efficiency of turns" },
            "turnBreakdown": {
              "type": "array",
              "description": "Per-turn purpose and effectiveness analysis (for significant turns only)",
              "items": {
                "type": "object",
                "properties": {
                  "turnId": { "type": "string" },
                  "purpose": { "type": "string", "description": "What this turn was about" },
                  "userIntent": { "type": "string", "description": "What the user wanted" },
                  "aiAction": { "type": "string", "description": "What AI did in response" },
                  "wasEffective": { "type": "boolean" },
                  "userReaction": { "type": "string", "enum": ["accepted", "modified", "ignored", "rejected", "clarified", "escalated", "topic_switched"] }
                }
              }
            }
          }
        },
        "conversationDynamics": {
          "type": "object",
          "description": "How the conversation flowed between user and AI",
          "properties": {
            "interactionPattern": {
              "type": "string",
              "enum": ["structured_delegation", "exploratory", "correction_heavy", "autonomous", "collaborative", "question_driven"],
              "description": "Dominant interaction pattern"
            },
            "askQuestionsUsage": {
              "type": "object",
              "properties": {
                "totalAsks": { "type": "integer" },
                "userEngagement": { "type": "string", "enum": ["fully_responsive", "partial", "dismissive"] },
                "answersInfluencedPlan": { "type": "boolean" }
              }
            },
            "subagentOrchestration": {
              "type": "object",
              "properties": {
                "totalDelegations": { "type": "integer" },
                "agentsUsed": { "type": "array", "items": { "type": "string" } },
                "delegationQuality": { "type": "string", "enum": ["appropriate", "over_delegated", "under_delegated"] },
                "resultUtilization": { "type": "string", "enum": ["high", "partial", "ignored"] }
              }
            },
            "conversationFlow": {
              "type": "string",
              "enum": ["linear", "branching", "iterative", "stuck_loop"],
              "description": "How conversation progressed"
            }
          }
        },
        "aiFeedbackUtilization": {
          "type": "object",
          "description": "How well AI feedback was utilized by the user",
          "properties": {
            "responseQuality": {
              "type": "object",
              "properties": {
                "truncatedResponses": { "type": "integer" },
                "totalResponses": { "type": "integer" },
                "truncationRate": { "type": "number" }
              }
            },
            "promptResponseAlignment": {
              "type": "string",
              "enum": ["high", "medium", "low", "misaligned"],
              "description": "How well user prompts and AI responses aligned"
            },
            "suggestionAdoptionRate": {
              "type": "string",
              "enum": ["high", "medium", "low"],
              "description": "How often user accepted AI suggestions"
            },
            "ignoredAdvicePatterns": {
              "type": "array",
              "description": "Notable instances where AI advice was ignored",
              "items": {
                "type": "object",
                "properties": {
                  "turnId": { "type": "string" },
                  "advice": { "type": "string" },
                  "userDid": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
