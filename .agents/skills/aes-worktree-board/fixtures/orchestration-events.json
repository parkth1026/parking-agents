{
  "schemaVersion": 1,
  "description": "Offline host-shaped wait_threads batches for orchestration selftest.",
  "batches": {
    "executorToReview": {
      "wake": [],
      "polls": [
        {
          "thread": "$executorThread",
          "kind": "final",
          "eventId": "E-$prefix-executing",
          "payload": {
            "summary": "executor started",
            "to": "executing",
            "cursor": "$prefix-executing"
          }
        },
        {
          "thread": "$executorThread",
          "kind": "final",
          "eventId": "E-$prefix-self-qa",
          "payload": {
            "summary": "executor self QA complete",
            "to": "self-qa",
            "cursor": "$prefix-self-qa"
          }
        },
        {
          "thread": "$executorThread",
          "kind": "final",
          "eventId": "E-$prefix-committed",
          "payload": {
            "summary": "executor committed",
            "to": "committed",
            "commitSha": "$commitSha",
            "cursor": "$prefix-committed"
          }
        },
        {
          "thread": "$executorThread",
          "kind": "final",
          "eventId": "E-$prefix-reviewing",
          "payload": {
            "summary": "executor requested independent review",
            "to": "reviewing",
            "commitSha": "$commitSha",
            "cursor": "$prefix-reviewing"
          }
        }
      ]
    },
    "reviewerApprove": {
      "wake": [
        {
          "thread": "$reviewerThread",
          "kind": "final",
          "eventId": "$approvalEventId",
          "payload": {
            "summary": "reviewer approved current commit",
            "verdict": "APPROVE",
            "commitSha": "$commitSha",
            "cursor": "$finalCursor"
          }
        }
      ],
      "polls": [
        {
          "thread": "$reviewerThread",
          "kind": "commentary",
          "eventId": "$pollEventId",
          "payload": {
            "summary": "reviewer poll",
            "cursor": "$pollCursor"
          }
        },
        {
          "thread": "$reviewerThread",
          "kind": "final",
          "eventId": "$approvalEventId",
          "payload": {
            "summary": "reviewer approved current commit",
            "verdict": "APPROVE",
            "commitSha": "$commitSha",
            "cursor": "$finalCursor"
          }
        }
      ]
    },
    "fiveTaskFanIn": {
      "wake": [
        {
          "thread": "$reviewerThread1",
          "kind": "final",
          "eventId": "E-fanin-wake-task1",
          "payload": {
            "summary": "reviewer final task 1 arrived as wake",
            "verdict": "APPROVE",
            "commitSha": "$commit1",
            "cursor": "$cursor1"
          }
        }
      ],
      "polls": [
        {
          "thread": "$executorThread3",
          "kind": "final",
          "eventId": "E-fanin-executor-final-task3",
          "payload": {
            "summary": "executor final task 3",
            "cursor": "$executorCursor3"
          }
        },
        {
          "thread": "$reviewerThread2",
          "kind": "final",
          "eventId": "E-fanin-reviewer-final-task2",
          "payload": {
            "summary": "reviewer final task 2",
            "verdict": "APPROVE",
            "commitSha": "$commit2",
            "cursor": "$cursor2"
          }
        },
        {
          "thread": "$reviewerThread3",
          "kind": "commentary",
          "eventId": "E-fanin-old-commentary-task3",
          "payload": {
            "summary": "old reviewer commentary task 3",
            "cursor": "$commentaryCursor3"
          }
        },
        {
          "thread": "$reviewerThread4",
          "kind": "verdict",
          "eventId": "E-fanin-reviewer-final-task4",
          "payload": {
            "summary": "reviewer final task 4",
            "verdict": "APPROVE",
            "commitSha": "$commit4",
            "cursor": "$cursor4"
          }
        },
        {
          "thread": "$reviewerThread5",
          "kind": "final",
          "eventId": "E-fanin-reviewer-final-task5",
          "payload": {
            "summary": "reviewer final task 5",
            "verdict": "APPROVE",
            "commitSha": "$commit5",
            "cursor": "$cursor5"
          }
        },
        {
          "thread": "$reviewerThread3",
          "kind": "commentary",
          "eventId": "E-fanin-reviewer-poll-task3",
          "payload": {
            "summary": "new reviewer poll task 3",
            "cursor": "$reviewerCursor3"
          }
        }
      ]
    },
    "reviewerBlock": {
      "wake": [],
      "polls": [
        {
          "thread": "$reviewerThread",
          "kind": "verdict",
          "eventId": "$eventId",
          "payload": {
            "summary": "reviewer blocked current commit",
            "verdict": "BLOCK",
            "commitSha": "$commitSha",
            "cursor": "$cursor",
            "finding": "final reviewer finding"
          }
        }
      ]
    },
    "lateEvent": {
      "wake": [],
      "polls": [
        {
          "thread": "$reviewerThread",
          "kind": "progress",
          "eventId": "$eventId",
          "payload": {
            "summary": "late reviewer progress",
            "to": "executing",
            "cursor": "$cursor"
          }
        }
      ]
    }
  }
}
